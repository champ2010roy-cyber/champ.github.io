<script>
let lang="en";const languageBtn=document.getElementById('lang');function setLang(next){lang=next;document.documentElement.lang=lang==='bn'?'bn':'en';document.querySelectorAll('[data-en]').forEach(el=>{el.textContent=el.dataset[lang]||el.textContent});document.querySelectorAll('[data-en-placeholder]').forEach(el=>el.placeholder=el.dataset[lang+'Placeholder']||el.placeholder);languageBtn.textContent=lang==='en'?'EN / বাংলা':'বাংলা / EN';updateModel()}languageBtn.addEventListener('click',()=>setLang(lang==='en'?'bn':'en'));document.getElementById('year').textContent=new Date().getFullYear();
const c=document.getElementById('plot'),ctx=c.getContext('2d');let W=600,H=320,rx=-.65,ry=.7,drag=false,lx=0,ly=0,phase=0,playing=false,raf=0;const formulas={ripple:'z = sin(√(x²+y²))',saddle:'z = (x² − y²)/4',wave:'z = sin(x) cos(y)',hill:'z = e⁻ʳ²'};
function heightAt(x,y){let a=+document.getElementById('amp').value,f=+document.getElementById('freq').value,m=document.getElementById('model').value;if(m==='ripple')return a*Math.sin(Math.sqrt(x*x+y*y)*f+phase);if(m==='saddle')return a*(x*x-y*y)/4;if(m==='wave')return a*Math.sin(x*f+phase)*Math.cos(y*f);return a*2*Math.exp(-.35*f*(x*x+y*y))}
function project(x,y,z){let cy=Math.cos(ry),sy=Math.sin(ry),cx=Math.cos(rx),sx=Math.sin(rx),xx=x*cy-z*sy,zz=x*sy+z*cy,yy=y*cx-zz*sx;zz=y*sx+zz*cx;let sc=Math.min(W,H)*.073,p=1/(1+zz*.018);return{x:W/2+xx*sc*p,y:H*.52+yy*sc*p,z:zz}}
function draw(){ctx.clearRect(0,0,W,H);let bg=ctx.createRadialGradient(W/2,H/2,5,W/2,H/2,Math.max(W,H)*.7);bg.addColorStop(0,'#103758');bg.addColorStop(1,'#030916');ctx.fillStyle=bg;ctx.fillRect(0,0,W,H);let lines=[],N=27,R=5.4;for(let ax=0;ax<2;ax++)for(let i=0;i<=N;i++){let pts=[];for(let j=0;j<=N;j++){let a=-R+2*R*i/N,b=-R+2*R*j/N,x=ax===0?a:b,y=ax===0?b:a;pts.push(project(x,y,heightAt(x,y)))}lines.push(pts)}lines.sort((a,b)=>a.reduce((s,p)=>s+p.z,0)/a.length-b.reduce((s,p)=>s+p.z,0)/b.length);lines.forEach((pts,i)=>{ctx.beginPath();pts.forEach((p,j)=>j?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.strokeStyle=i%3===0?'rgba(75,225,255,.72)':'rgba(113,157,255,.38)';ctx.lineWidth=i%3===0?1.15:.7;ctx.stroke()});ctx.fillStyle='#c4f8ff';ctx.font='12px system-ui';ctx.fillText('x',W*.85,H*.73);ctx.fillText('y',W*.59,H*.88);ctx.fillText('z',W*.52,H*.13)}
function updateModel(){let m=document.getElementById('model').value;document.getElementById('formula').textContent=formulas[m];document.getElementById('cap').textContent=formulas[m];document.getElementById('explain').textContent=lang==='bn'?(m==='saddle'?'স্যাডল সারফেস একদিকে ওপরে ও লম্ব দিকে নিচে বাঁকে।':m==='wave'?'দুটি তরঙ্গ মিলিয়ে পুনরাবৃত্ত সারফেস তৈরি হয়।':m==='hill'?'কেন্দ্রে উঁচু পাহাড়; দূরত্ব বাড়লে উচ্চতা কমে।':'কেন্দ্র থেকে তরঙ্গ ছড়ায়; উচ্চতা দূরত্বের ওপর নির্ভর করে।'):(m==='saddle'?'A saddle curves upward in one direction and downward in the perpendicular direction.':m==='wave'?'Two waves combine to make a repeating surface.':m==='hill'?'A smooth hill peaks at the origin and falls with distance.':'A wave spreads from the origin; height depends on distance.');draw()}
['model','amp','freq'].forEach(id=>document.getElementById(id).addEventListener('input',updateModel));function tick(){if(playing){phase+=.035;draw();raf=requestAnimationFrame(tick)}}document.getElementById('animate').addEventListener('click',()=>{playing=!playing;document.getElementById('animate').textContent=playing?(lang==='bn'?'Ⅱ থামাও':'Ⅱ Pause'):(lang==='bn'?'▶ অ্যানিমেশন চালাও':'▶ Animate');if(playing)tick();else cancelAnimationFrame(raf)});document.getElementById('reset').addEventListener('click',()=>{rx=-.65;ry=.7;phase=0;draw()});function resize(){let r=c.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,2);W=Math.max(300,r.width);H=320;c.width=W*d;c.height=H*d;ctx.setTransform(d,0,0,d,0,0);draw()}c.addEventListener('pointerdown',e=>{drag=true;lx=e.clientX;ly=e.clientY;c.setPointerCapture(e.pointerId)});c.addEventListener('pointermove',e=>{if(!drag)return;ry+=(e.clientX-lx)*.008;rx+=(e.clientY-ly)*.008;lx=e.clientX;ly=e.clientY;draw()});c.addEventListener('pointerup',()=>drag=false);c.addEventListener('pointercancel',()=>drag=false);window.addEventListener('resize',resize);resize();updateModel();
const details=[
[{en:'Why 0.999… equals 1',bn:'0.999… = 1 কেন?'},{en:'Let x=0.999… . Then 10x=9.999… . Subtract the first equation from the second: 9x=9, so x=1. The repeating decimal is infinite, not merely a finite decimal close to 1.',bn:'ধরি x=0.999…। তাহলে 10x=9.999…। দ্বিতীয় সমীকরণ থেকে প্রথমটি বিয়োগ করলে 9x=9, তাই x=1। এটি অসীম দশমিক, ১-এর কাছাকাছি কোনো সসীম দশমিক নয়।'}],
[{en:'Why π is irrational',bn:'π অমূলদ কেন?'},{en:'π cannot be expressed as a ratio of two integers. Its decimal expansion is infinite and non-periodic. Lambert proved its irrationality in the 18th century.',bn:'π-কে দুটি পূর্ণসংখ্যার অনুপাত হিসেবে প্রকাশ করা যায় না। এর দশমিক বিস্তার অসীম ও পর্যায়ক্রমিক নয়। ল্যামবার্ট ১৮শ শতকে এর অমূলদতা প্রমাণ করেন।'}],
[{en:'Cantor’s diagonal argument',bn:'ক্যান্টরের ডায়াগোনাল যুক্তি'},{en:'If you try to list all real numbers between 0 and 1, construct a new decimal whose nth digit differs from the nth digit of the nth listed number. It differs from every entry, so the list cannot be complete.',bn:'০ ও ১-এর মাঝের সব বাস্তব সংখ্যার তালিকা করতে চাইলে একটি নতুন দশমিক বানাও, যার n-তম অঙ্ক তালিকার n-তম সংখ্যার n-তম অঙ্ক থেকে আলাদা। নতুন সংখ্যাটি প্রতিটি এন্ট্রি থেকে আলাদা, তাই তালিকা সম্পূর্ণ হতে পারে না।'}]
];function showFact(i){document.getElementById('modalTitle').textContent=details[i][0][lang];document.getElementById('modalText').textContent=details[i][1][lang];document.getElementById('modal').classList.add('open')}document.querySelectorAll('.factbtn').forEach(b=>b.addEventListener('click',()=>showFact(+b.dataset.fact)));document.getElementById('surprise').addEventListener('click',()=>showFact(Math.floor(Math.random()*3)));document.getElementById('close').addEventListener('click',()=>document.getElementById('modal').classList.remove('open'));document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')e.currentTarget.classList.remove('open')});document.addEventListener('keydown',e=>{if(e.key==='Escape')document.getElementById('modal').classList.remove('open')});
function search(){let q=document.getElementById('search').value.trim().toLowerCase(),n=0;document.querySelectorAll('.searchable .card').forEach(el=>{let ok=!q||(el.innerText+' '+el.dataset.search).toLowerCase().includes(q);el.classList.toggle('hidden',!ok);if(ok)n++});let no=document.getElementById('noResults');no.hidden=n>0}document.getElementById('searchBtn').addEventListener('click',search);document.getElementById('search').addEventListener('keydown',e=>{if(e.key==='Enter')search()});
</script></body></html>